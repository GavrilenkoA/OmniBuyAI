# ═══════════════════════════════════════════════════════════
# OmniBuyAI Configuration File
# ═══════════════════════════════════════════════════════════
# Скопируйте этот файл в .env и заполните актуальными значениями
# Command: cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# 1. LLM API (GROQ)
# ───────────────────────────────────────────────────────────
# Получите API ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_api_key_here

# Модель LLM (доступные: https://console.groq.com/docs/models)
LLM_MODEL=llama-3.3-70b-versatile

# Base URL для Groq API (не менять, если используете Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1


# ───────────────────────────────────────────────────────────
# 2. BACKEND SERVER (FastAPI)
# ───────────────────────────────────────────────────────────
# Хост и порт для запуска backend сервера
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# URL backend для Chrome extension (production)
# Для локальной разработки: http://localhost:8000
# Для production: https://your-domain.com
BACKEND_URL=http://localhost:8000


# ───────────────────────────────────────────────────────────
# 3. PEREKRESTOK API
# ───────────────────────────────────────────────────────────
# Base URL для API Перекрёстка (не менять)
PEREKRESTOK_API_BASE_URL=https://www.perekrestok.ru/api/customer/1.4.1.0

# Сайт Перекрёстка (не менять)
PEREKRESTOK_SITE_URL=https://www.perekrestok.ru

# Задержка между запросами к API (секунды)
# Увеличьте при проблемах с rate limiting
PEREKRESTOK_REQUEST_DELAY=0.3


# ───────────────────────────────────────────────────────────
# 4. CHROME EXTENSION
# ───────────────────────────────────────────────────────────
# URL backend для Chrome extension
# Должен совпадать с BACKEND_URL выше
EXTENSION_BACKEND_URL=http://localhost:8000/api/v1

# Таймаут запросов к API (миллисекунды)
EXTENSION_API_TIMEOUT=30000

# Количество попыток при ошибке запроса
EXTENSION_API_RETRIES=3


# ───────────────────────────────────────────────────────────
# 5. DATA DIRECTORY
# ───────────────────────────────────────────────────────────
# Путь к директории с данными (товары, категории)
# Относительно корня проекта
DATA_DIR=data


# ───────────────────────────────────────────────────────────
# 6. LOGGING
# ───────────────────────────────────────────────────────────
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ───────────────────────────────────────────────────────────
# 7. CORS (Cross-Origin Resource Sharing)
# ───────────────────────────────────────────────────────────
# Разрешённые источники для API запросов
# Для production укажите домен вашего фронтенда
# Пример: https://your-frontend.com
CORS_ALLOW_ORIGINS=*
