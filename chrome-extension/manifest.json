{
  "manifest_version": 3,
  "name": "Perekrestok AI Assistant",
  "version": "1.0.0",
  "description": "AI-powered shopping assistant for Perekrestok.ru",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://perekrestok.ru/*",
    "https://www.perekrestok.ru/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Perekrestok AI Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://perekrestok.ru/*", "https://www.perekrestok.ru/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
